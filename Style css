/* ==========================================================================
   TIC-TAC-TOE ARENA - COMPLETE STYLING
   ========================================================================== */

:root {
  --bg-gradient: radial-gradient(circle at 50% 20%, #0d1424 0%, #070b14 100%);
  --surface-board: rgba(15, 23, 42, 0.85);
  --surface-cell: rgba(2, 6, 23, 0.7);
  --surface-cell-hover: rgba(15, 23, 42, 0.95);
  
  --color-x: #06b6d4;
  --glow-x: 0 0 18px rgba(6, 182, 212, 0.6);
  --color-o: #f43f5e;
  --glow-o: 0 0 18px rgba(244, 63, 94, 0.6);
  
  --color-text: #f8fafc;
  --color-muted: #94a3b8;
  --color-border: rgba(255, 255, 255, 0.1);
  --radius-board: 28px;
  --radius-cell: 18px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
}

body {
  background: var(--bg-gradient);
  color: var(--color-text);
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.game-container {
  position: relative;
  width: 100%;
  max-width: 580px;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 24px 20px;
}

/* --- HUD & Perimeter Scoring --- */
.hud {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  z-index: 10;
}

.score-cluster {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border-radius: 16px;
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid var(--color-border);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.score-cluster.active-x {
  border-color: rgba(6, 182, 212, 0.5);
  box-shadow: 0 0 25px rgba(6, 182, 212, 0.25);
  background: rgba(15, 23, 42, 0.95);
}

.score-cluster.active-o {
  border-color: rgba(244, 63, 94, 0.5);
  box-shadow: 0 0 25px rgba(244, 63, 94, 0.25);
  background: rgba(15, 23, 42, 0.95);
}

.mark-badge {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 1.25rem;
  font-family: 'Outfit', sans-serif;
}

.mark-badge.x {
  background: rgba(6, 182, 212, 0.15);
  color: var(--color-x);
}

.mark-badge.o {
  background: rgba(244, 63, 94, 0.15);
  color: var(--color-o);
}

.player-info {
  display: flex;
  flex-direction: column;
}

.player-info.right {
  text-align: right;
}

.player-name {
  font-size: 0.85rem;
  font-weight: 700;
  color: #fff;
}

.score-readout {
  font-size: 0.75rem;
  color: var(--color-muted);
  font-family: monospace;
}

.score-readout strong {
  font-size: 0.95rem;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.series-cluster {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.match-ratio {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: monospace;
  font-size: 1.1rem;
  font-weight: 800;
}

.score-accent-x { color: var(--color-x); }
.score-accent-o { color: var(--color-o); }

.draws-label {
  font-size: 0.65rem;
  letter-spacing: 0.05em;
  color: var(--color-muted);
}

.turn-indicator {
  margin-top: 4px;
  font-size: 0.75rem;
  font-family: monospace;
  color: #38bdf8;
  letter-spacing: 0.02em;
}

/* --- Central Board & Cells --- */
.board-wrapper {
  position: relative;
  width: 100%;
  max-width: 420px;
  aspect-ratio: 1 / 1;
  margin: auto;
  z-index: 10;
}

.board {
  width: 100%;
  height: 100%;
  padding: 16px;
  border-radius: var(--radius-board);
  background: var(--surface-board);
  border: 1px solid rgba(6, 182, 212, 0.2);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(16px);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 12px;
}

.cell {
  position: relative;
  background: var(--surface-cell);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: var(--radius-cell);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease-out;
  outline: none;
}

.cell:hover:not(:disabled) {
  background: var(--surface-cell-hover);
  border-color: rgba(6, 182, 212, 0.4);
  transform: scale(1.02);
}

.cell:focus-visible {
  ring: 2px solid #fff;
  border-color: #fff;
}

.cell.marked-x::before,
.cell.marked-x::after {
  content: '';
  position: absolute;
  width: 55%;
  height: 8px;
  background-color: var(--color-x);
  border-radius: 4px;
  box-shadow: var(--glow-x);
  animation: markPop 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.cell.marked-x::before { transform: rotate(45deg); }
.cell.marked-x::after { transform: rotate(-45deg); }

.cell.marked-o::before {
  content: '';
  position: absolute;
  width: 50%;
  height: 50%;
  border-radius: 50%;
  border: 7.5px solid var(--color-o);
  box-shadow: var(--glow-o);
  animation: markPop 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.cell.winner {
  background: rgba(255, 255, 255, 0.12);
  border-color: #fff;
  transform: scale(1.04);
  box-shadow: 0 0 30px rgba(255, 255, 255, 0.3);
}

/* --- SVG Strike Line --- */
.strike-line {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 20;
}

.strike-path {
  stroke: #ffffff;
  stroke-width: 4;
  stroke-linecap: round;
  stroke-dasharray: 100;
  stroke-dashoffset: 0;
  filter: drop-shadow(0 0 8px #38bdf8);
  animation: strikeDraw 0.35s ease-out forwards;
}

/* --- Bottom Toolbar Controls --- */
.controls-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  z-index: 10;
}

.btn {
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid var(--color-border);
  color: var(--color-muted);
  font-size: 0.75rem;
  font-weight: 600;
  padding: 8px 14px;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.15s ease;
  font-family: monospace;
}

.btn:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.25);
}

/* --- Particle Canvas --- */
#particle-canvas {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 40;
}

/* --- Animations --- */
@keyframes markPop {
  0% { transform: scale(0.3) rotate(-10deg); opacity: 0; }
  70% { transform: scale(1.1) rotate(2deg); opacity: 1; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

@keyframes strikeDraw {
  0% { stroke-dashoffset: 100; opacity: 0; }
  30% { opacity: 1; }
  100% { stroke-dashoffset: 0; opacity: 1; }
}

.shake {
  animation: boardShake 0.25s ease-in-out;
}

@keyframes boardShake {
  0%, 100% { transform: translate(0, 0); }
  25% { transform: translate(-3px, 2px); }
  50% { transform: translate(3px, -2px); }
  75% { transform: translate(-2px, 1px); }
}
